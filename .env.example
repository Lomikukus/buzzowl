# Buzzowl — environment template.
# Copy to .env (gitignored) and fill in. docker-compose.yml interpolates these;
# safe defaults are marked. DATABASE_URL is NOT needed here — compose sets it
# per-service to the internal db container.

# --- Required ------------------------------------------------------------------

# Shared secret between server and agent-pi. MUST be set — generate with:
#   openssl rand -hex 32
# Both sides are fail-closed: without it the server's internal APIs and every
# agent-pi endpoint answer 401. ALLOW_INSECURE_INTERNAL=1 disables that check
# on both — local dev only, never on an instance anyone else can reach.
AGENT_SERVICE_TOKEN=

# OpenRouter API key — the only LLM backend in normal operation (chat, agents,
# embeddings). Legacy name OPENROUTE is still read as a fallback by compose and
# the app; new setups should use OPENROUTER_API_KEY only.
OPENROUTER_API_KEY=
# OPENROUTE=          # legacy alias, only for old .env files — do not set both

# --- First-boot admin bootstrap ------------------------------------------------
# Credentials for the initial admin account (server-side support ships separately).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional LLM providers ----------------------------------------------------

# Claude API (opt-in via config.yaml agent_brain/pi_chat_brain)
ANTHROPIC_API_KEY=
# OpenAI-compatible provider for Pi (rarely used)
OPENAI_API_KEY=

# --- Embeddings (defaults target OpenRouter; see project_embeddings_backend) ---

EMBED_BACKEND=openai
EMBED_URL=https://openrouter.ai/api
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=768
# Defaults to OPENROUTER_API_KEY (then legacy OPENROUTE) when unset.
EMBED_API_KEY=

# --- Transcription -------------------------------------------------------------

# HuggingFace token for WhisperX speaker diarization (pyannote models)
HFTOKEN=

# --- Notifications (optional) --------------------------------------------------

# Telegram bot token + chat id for agent/monitor notifications
# Telegram bot token (@BotFather). Each USER connects their own chat in
# Settings → Notifications and chooses what to receive; the bot polls Telegram
# by default (no public URL needed). Set config notifications.telegram_webhook_url
# to use a webhook instead.
TELEGRAMBOT=
# Optional operator/admin chat id(s), comma-separated — receives ONLY feedback
# and system messages. Product notifications go to people, never here.
TELEGRAM_CHAT_ID=

# SMTP for outgoing mail (mail generation feature); leave empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Buzzowl

# --- Infrastructure ------------------------------------------------------------

# Architecture tag of the locally built camofox image (see docker-compose.yml —
# the image must be built manually once: cd camofox-browser && make build).
# Apple Silicon: aarch64 (default) | Linux/Intel: x86_64
CAMOFOX_ARCH=aarch64

# SearXNG secret_key (compose ships a dev fallback for the internal-only
# container; set a real one in prod): openssl rand -hex 32
SEARXNG_SECRET=

# Max concurrent agent runs in agent-pi
AGENT_MAX_CONCURRENT=2

# Cloudflare tunnel token — only needed with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Rate limiting. Endpoints without a stricter limit of their own fall back to
# this, per client IP and view function; /api/health and the agent-service
# callbacks are exempt. Raise it if a scripted client legitimately needs more.
# RATE_LIMIT_DEFAULT=300/minute
# Address of the reverse proxy whose X-Forwarded-For may be trusted. REQUIRED
# when TLS is terminated elsewhere (cloudflared, nginx, …) — without it every
# request looks like it comes from the proxy and all users share one bucket.
# Not "*": compose publishes port 8000 on the host, so that would be spoofable.
# FORWARDED_ALLOW_IPS=172.18.0.5

# IMAP (optional) — reply/bounce ingestion for supervised outreach
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# --- Hosted / multi-tenant (Phase 6a) --------------------------------------
# Encrypts per-org LLM keys (and the federation access token) at rest.
# SET IT ON THE FIRST INSTALL — openssl rand -hex 32 — and never change it.
# Left empty, the encryption key is derived from AGENT_SERVICE_TOKEN instead, so
# rotating that token orphans every stored org key: they cannot be recovered,
# only entered again by hand under Settings › LLM.
BUZZOWL_SECRET_KEY=
# Lets the operator change org plans/budgets when hosted.signup_enabled is on.
# HOSTED_OPERATOR_KEY=change-me-too

# --- Matrix federation (Phase 5b) — optional, only with --profile federation --
# Public DNS name of your bundled homeserver (partners on other installs must
# reach it over TLS); keep the default `synapse` for a single shared homeserver.
# SYNAPSE_SERVER_NAME=matrix.example.com
# Lets Buzzowl create bot accounts on the bundled Synapse (also set it as
# federation.registration_shared_secret in config.yaml).
# SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-long-random
